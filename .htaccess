# v1.2: gzip для текстовых ответов (JSON из api/*.php — самый большой выигрыш:
# каталог ~500 КБ сжимается примерно до 60-90 КБ).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/json text/html text/css text/plain application/javascript image/svg+xml
</IfModule>

# Статика: переиспользуем браузерный кэш, но HTML и JS обновляем по query-версии (?v=...)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
